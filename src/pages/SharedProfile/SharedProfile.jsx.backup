import React, { useState, useEffect } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { ChevronDown, Download, X } from 'lucide-react';
import config from '../../config/env';

export default function SharedProfile() {
  const { vendorId } = useParams();
  const navigate = useNavigate();
  const [vendorData, setVendorData] = useState(null);
  const [profileData, setProfileData] = useState(null);
  const [projects, setProjects] = useState([]);
  const [products, setProducts] = useState([]);
  const [services, setServices] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [expandedProjects, setExpandedProjects] = useState({});
  const [showDetailsForm, setShowDetailsForm] = useState(true);
  const [isSaving, setIsSaving] = useState(false);
  const [visitorData, setVisitorData] = useState({
    visitorName: '',
    visitorCompany: '',
    visitorPhone: '',
    visitorState: '',
    visitorCountry: ''
  });

  useEffect(() => {
    const visitorKey = `visitor_submitted_${vendorId}`;
    const hasSubmitted = localStorage.getItem(visitorKey);
    
    if (hasSubmitted) {
      setShowDetailsForm(false);
    } else {
      setShowDetailsForm(true);
    }
    
    fetchSharedData();
  }, [vendorId]);

  const fetchSharedData = async () => {
    try {
      setLoading(true);
      
      const response = await fetch(`${config.VENDOR_BACKEND_URL}/api/vendor/shared/${vendorId}`);
      
      if (!response.ok) {
        throw new Error('Failed to load shared profile');
      }
      
      const data = await response.json();
      console.log('Shared profile API response:', data);
      
      if (data.success && data.data) {
        const vendor = data.data;
        
        const stateVal = vendor.companyDetails?.state;
        const countryVal = vendor.companyDetails?.country;
        let location = 'Not provided';
        
        if (stateVal && stateVal !== 'Not Specified') {
          location = stateVal;
          if (countryVal && countryVal !== 'Not Specified') {
            location = `${stateVal}, ${countryVal}`;
          }
        } else if (countryVal && countryVal !== 'Not Specified') {
          location = countryVal;
        }
        
        const companyName = vendor.companyDetails?.companyName || vendor.vendorDetails?.companyName || vendor.name || 'Not provided';
        const phone = vendor.vendorDetails?.primaryContactPhone || 'Not provided';
        
        setProfileData({
          name: vendor.vendorDetails?.primaryContactName || 'Not provided',
          vendorId: `#${vendor._id?.substring(0, 6) || 'UNKNOWN'}`,
          companyName: companyName,
          phone: phone,
          location: location,
          email: vendor.vendorDetails?.primaryContactEmail || 'Not provided',
        });
        
        setVendorData(vendor);
        
        if (vendor.projects) {
          setProjects(vendor.projects);
        }
        
        if (vendor.products) {
          setProducts(vendor.products);
        }

        // Use actual services from the vendor data
        if (vendor.services && vendor.services.length > 0) {
          setServices(vendor.services);
        }
      }
      
      setLoading(false);
    } catch (err) {
      console.error('Error loading shared profile:', err);
      setError('Unable to load this profile. It may have been removed or the link is invalid.');
      setLoading(false);
    }
  };

  const handleFormChange = (e) => {
    const { name, value } = e.target;
    setVisitorData(prev => ({
      ...prev,
      [name]: value
    }));
  };

  const handleSaveDetails = async () => {
    try {
      setIsSaving(true);

      if (!visitorData.visitorName || !visitorData.visitorCompany || !visitorData.visitorPhone || !visitorData.visitorState || !visitorData.visitorCountry) {
        alert('Please fill in all fields');
        setIsSaving(false);
        return;
      }

      const visitorPayload = {
        vendorId: vendorId,
        visitorName: visitorData.visitorName,
        visitorCompany: visitorData.visitorCompany,
        visitorPhone: visitorData.visitorPhone,
        visitorState: visitorData.visitorState,
        visitorCountry: visitorData.visitorCountry,
        visitedAt: new Date().toISOString()
      };

      try {
        const response = await fetch(`${config.VENDOR_BACKEND_URL}/api/vendor/save-visitor`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(visitorPayload)
        });

        if (response.ok) {
          console.log('Visitor data saved to backend');
        }
      } catch (backendError) {
        console.warn('Could not save to backend:', backendError);
      }

      const visitorKey = `visitor_submitted_${vendorId}`;
      localStorage.setItem(visitorKey, JSON.stringify({
        submittedAt: new Date().toISOString(),
        ...visitorData
      }));

      setShowDetailsForm(false);
      setIsSaving(false);
    } catch (error) {
      console.error('Error saving visitor details:', error);
      alert('Error. Please try again.');
      setIsSaving(false);
    }
  };

  const toggleProjectExpansion = (projectId) => {
    setExpandedProjects(prev => ({
      ...prev,
      [projectId]: !prev[projectId]
    }));
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-gray-50 flex items-center justify-center">
        <div className="text-center">
          <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-emerald-600 mx-auto mb-4"></div>
          <p className="text-gray-600">Loading profile...</p>
        </div>
      </div>
    );
  }

  if (error || !vendorData) {
    return (
      <div className="min-h-screen bg-gray-50 flex items-center justify-center">
        <div className="text-center">
          <p className="text-red-600 mb-4">{error || 'Profile not found'}</p>
          <button
            onClick={() => navigate('/')}
            className="text-emerald-600 hover:text-emerald-700 font-medium"
          >
            Back to home
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-50">
      {/* Visitor Form Modal */}
      {showDetailsForm && (
        <div className="fixed inset-0 bg-black bg-opacity-80 flex items-center justify-center z-50 backdrop-blur-sm">
          <div className="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
            <div className="p-6 border-b border-gray-200">
              <h2 className="text-xl font-bold text-gray-900">Visitor Information</h2>
              <p className="text-sm text-gray-500 mt-1">Please provide your details to access this vendor profile</p>
            </div>

            <div className="p-6 space-y-4">
              <p className="text-sm text-gray-600 mb-6">Please fill in your details to view the vendor profile.</p>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Full Name *</label>
                <input
                  type="text"
                  name="visitorName"
                  value={visitorData.visitorName}
                  onChange={handleFormChange}
                  placeholder="Your full name"
                  className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-transparent outline-none"
                />
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Company Name *</label>
                <input
                  type="text"
                  name="visitorCompany"
                  value={visitorData.visitorCompany}
                  onChange={handleFormChange}
                  placeholder="Your company name"
                  className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-transparent outline-none"
                />
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Phone Number *</label>
                <input
                  type="tel"
                  name="visitorPhone"
                  value={visitorData.visitorPhone}
                  onChange={handleFormChange}
                  placeholder="Your phone number"
                  className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-transparent outline-none"
                />
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">State *</label>
                <input
                  type="text"
                  name="visitorState"
                  value={visitorData.visitorState}
                  onChange={handleFormChange}
                  placeholder="Your state"
                  className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-transparent outline-none"
                />
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Country *</label>
                <input
                  type="text"
                  name="visitorCountry"
                  value={visitorData.visitorCountry}
                  onChange={handleFormChange}
                  placeholder="Your country"
                  className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-transparent outline-none"
                />
              </div>
            </div>

            <div className="flex gap-3 p-6 border-t border-gray-200">
              <button
                onClick={handleSaveDetails}
                disabled={isSaving}
                className="w-full px-4 py-2 bg-emerald-600 text-white font-medium rounded-lg hover:bg-emerald-700 disabled:opacity-50 flex items-center justify-center gap-2"
              >
                {isSaving ? (
                  <>
                    <div className="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></div>
                    Saving...
                  </>
                ) : (
                  'Submit & View Profile'
                )}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Profile Content - Show when form is submitted */}
      {!showDetailsForm && (
        <>
          {/* Header */}
          <div className="bg-gradient-to-r from-[#095B49] to-[#000000] text-white py-8">
            <div className="max-w-7xl mx-auto px-4">
              <h1 className="text-3xl font-bold">{profileData?.companyName}</h1>
              <p className="text-gray-300 mt-2">Shared Business Profile</p>
            </div>
          </div>

          {/* All Content - Portfolio, Projects, and Products */}
          <div className="max-w-7xl mx-auto px-4 py-8">
            {/* Portfolio / Company Details Section */}
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
              <div className="md:col-span-1">
                {/* Profile Card */}
                <div className="bg-white rounded-lg shadow-md p-6 sticky top-24">
                  <div className="text-center mb-6">
                    <div className="w-24 h-24 bg-gradient-to-br from-blue-400 to-blue-600 rounded-full mx-auto mb-4 flex items-center justify-center">
                      <span className="text-white text-2xl font-bold">
                        {profileData?.name?.charAt(0).toUpperCase()}
                      </span>
                    </div>
                    <h3 className="text-lg font-bold text-gray-900">{profileData?.name}</h3>
                    <p className="text-sm text-gray-500">{profileData?.vendorId}</p>
                  </div>
                  
                  <div className="space-y-4 border-t pt-4">
                    <div>
                      <p className="text-xs text-gray-500 uppercase">Company</p>
                      <p className="font-medium text-gray-900">{profileData?.companyName || 'Not provided'}</p>
                    </div>
                    <div>
                      <p className="text-xs text-gray-500 uppercase">Email</p>
                      <p className="font-medium text-gray-900 break-words">{profileData?.email}</p>
                    </div>
                    <div>
                      <p className="text-xs text-gray-500 uppercase">Phone</p>
                      <p className="font-medium text-gray-900">{profileData?.phone || 'Not provided'}</p>
                    </div>
                    <div>
                      <p className="text-xs text-gray-500 uppercase">Location</p>
                      <p className="font-medium text-gray-900">{profileData?.location || 'Not provided'}</p>
                    </div>
                  </div>
                </div>
              </div>
              
              <div className="md:col-span-2">
                {/* Company Details */}
                <div className="bg-white rounded-lg shadow-md p-6">
                  <h2 className="text-2xl font-bold text-gray-900 mb-6">Company Details</h2>
                  
                  <div className="space-y-6">
                    <div>
                      <h3 className="text-sm font-medium text-gray-500 uppercase mb-2">Industry Type</h3>
                      <p className="text-gray-900">{vendorData?.companyDetails?.industryType || 'Not specified'}</p>
                    </div>
                    
                    <div>
                      <h3 className="text-sm font-medium text-gray-500 uppercase mb-2">Segments</h3>
                      {vendorData?.companyDetails?.segments && vendorData.companyDetails.segments.length > 0 ? (
                        <div className="flex flex-wrap gap-2">
                          {vendorData.companyDetails.segments.map((segment, idx) => (
                            <span key={idx} className="bg-emerald-100 text-emerald-800 px-3 py-1 rounded text-sm">
                              {segment}
                            </span>
                          ))}
                        </div>
                      ) : (
                        <p className="text-gray-500 text-sm">No segments specified</p>
                      )}
                    </div>
                    
                    <div>
                      <h3 className="text-sm font-medium text-gray-500 uppercase mb-2">Year of Establishment</h3>
                      <p className="text-gray-900">{vendorData?.companyDetails?.yearOfEstablishment || 'Not specified'}</p>
                    </div>
                    
                    <div>
                      <h3 className="text-sm font-medium text-gray-500 uppercase mb-2">Vision and Mission</h3>
                      <p className="text-gray-900">{vendorData?.companyDetails?.visionAndMission || 'Not specified'}</p>
                    </div>
                    
                    <div>
                      <h3 className="text-sm font-medium text-gray-500 uppercase mb-2">Company Overview</h3>
                      <p className="text-gray-900">{vendorData?.companyDetails?.companyOverview || 'Not specified'}</p>
                    </div>
                    
                    <div>
                      <h3 className="text-sm font-medium text-gray-500 uppercase mb-2">Industry Overview</h3>
                      <p className="text-gray-900">{vendorData?.companyDetails?.industryOverview || 'Not specified'}</p>
                    </div>
                    
                    <div>
                      <h3 className="text-sm font-medium text-gray-500 uppercase mb-2">Core Values</h3>
                      {vendorData?.companyDetails?.coreValues && vendorData.companyDetails.coreValues.length > 0 ? (
                        <ul className="list-disc list-inside space-y-1">
                          {vendorData.companyDetails.coreValues.map((value, idx) => (
                            <li key={idx} className="text-gray-900">{value}</li>
                          ))}
                        </ul>
                      ) : (
                        <p className="text-gray-500 text-sm">No core values specified</p>
                      )}
                    </div>
                    
                    <div>
                      <h3 className="text-sm font-medium text-gray-500 uppercase mb-2">Certifications</h3>
                      {vendorData?.companyDetails?.certifications && vendorData.companyDetails.certifications.length > 0 ? (
                        <div className="space-y-2">
                          {vendorData.companyDetails.certifications.map((cert, idx) => (
                            <div key={idx} className="border border-gray-200 rounded p-3">
                              <p className="text-sm font-medium text-gray-900">{cert.originalName || cert.name || 'Certification'}</p>
                              {cert.url && (
                                <a href={cert.url} target="_blank" rel="noopener noreferrer" className="text-emerald-600 text-sm hover:underline">
                                  View Certificate →
                                </a>
                              )}
                            </div>
                          ))}
                        </div>
                      ) : (
                        <p className="text-gray-500 text-sm">No certifications uploaded</p>
                      )}
                    </div>
                    
                    <div>
                      <h3 className="text-sm font-medium text-gray-500 uppercase mb-2">Team Size</h3>
                      <p className="text-gray-900">{vendorData?.companyDetails?.teamSize || 'Not specified'}</p>
                    </div>
                    
                    <div>
                      <h3 className="text-sm font-medium text-gray-500 uppercase mb-2">Unique Selling Proposition</h3>
                      <p className="text-gray-900">{vendorData?.companyDetails?.uniqueSellingProposition || 'Not specified'}</p>
                    </div>
                    
                    <div>
                      <h3 className="text-sm font-medium text-gray-500 uppercase mb-2">Social Impact/CSR focus</h3>
                      <p className="text-gray-900">{vendorData?.companyDetails?.socialImpact || 'Not specified'}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            {/* Divider */}
            <hr className="my-12" />

            {/* Projects Section */}
            <div className="mb-12">
              <h2 className="text-3xl font-bold text-gray-900 mb-2">Projects</h2>
              <p className="text-gray-600 mb-8">Recent works and collaborations</p>
              
              {projects && projects.length > 0 ? (
                <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                  {projects.map((project, index) => (
                    <div key={project._id || project.id || index} className="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow">
                      <div className="p-6 border-b border-gray-100">
                        <h3 className="font-bold text-lg text-gray-900">{project.title || 'Untitled Project'}</h3>
                        <p className="text-sm text-gray-600 mt-2">{project.description || 'No description provided'}</p>
                      </div>
                      
                      <div className="p-6 space-y-4">
                        {project.client && (
                          <div>
                            <p className="text-xs font-medium text-gray-500 uppercase mb-1">Client</p>
                            <p className="text-sm text-gray-900">{project.client}</p>
                          </div>
                        )}
                        {project.duration && (
                          <div>
                            <p className="text-xs font-medium text-gray-500 uppercase mb-1">Duration</p>
                            <p className="text-sm text-gray-900">{project.duration}</p>
                          </div>
                        )}
                        {project.category && (
                          <div>
                            <p className="text-xs font-medium text-gray-500 uppercase mb-1">Category</p>
                            <p className="text-sm text-gray-900">{project.category}</p>
                          </div>
                        )}
                        
                        <button
                          onClick={() => toggleProjectExpansion(project._id || project.id || index)}
                          className="w-full mt-4 pt-4 border-t border-gray-100 text-emerald-600 hover:text-emerald-700 text-sm font-medium flex items-center justify-center gap-2"
                        >
                          {expandedProjects[project._id || project.id || index] ? 'Show Less' : 'Show More'}
                          <ChevronDown size={16} className={`transform transition-transform ${expandedProjects[project._id || project.id || index] ? 'rotate-180' : ''}`} />
                        </button>
                        
                        {expandedProjects[project._id || project.id || index] && (
                          <div className="pt-4 border-t border-gray-100 space-y-4">
                            {project.objective && (
                              <div>
                                <p className="text-xs font-medium text-gray-500 uppercase mb-1">Objective</p>
                                <p className="text-sm text-gray-700">{project.objective}</p>
                              </div>
                            )}
                            {project.features && (
                              <div>
                                <p className="text-xs font-medium text-gray-500 uppercase mb-1">Key Features</p>
                                <p className="text-sm text-gray-700">{project.features}</p>
                              </div>
                            )}
                            {project.impact && (
                              <div>
                                <p className="text-xs font-medium text-gray-500 uppercase mb-1">Impact</p>
                                <p className="text-sm text-gray-700">{project.impact}</p>
                              </div>
                            )}
                            {project.team && (
                              <div>
                                <p className="text-xs font-medium text-gray-500 uppercase mb-1">Team</p>
                                <p className="text-sm text-gray-700">{project.team}</p>
                              </div>
                            )}
                            {project.deliverables && (
                              <div>
                                <p className="text-xs font-medium text-gray-500 uppercase mb-1">Deliverables</p>
                                <p className="text-sm text-gray-700">{project.deliverables}</p>
                              </div>
                            )}
                            {project.compliance && (
                              <div>
                                <p className="text-xs font-medium text-gray-500 uppercase mb-1">Compliance</p>
                                <p className="text-sm text-gray-700">{project.compliance}</p>
                              </div>
                            )}
                            {project.documents && project.documents.length > 0 && (
                              <div>
                                <p className="text-xs font-medium text-gray-500 uppercase mb-2">Documents</p>
                                <div className="space-y-2">
                                  {project.documents.map((doc, docIndex) => (
                                    <a
                                      key={docIndex}
                                      href={doc.url || '#'}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      className="flex items-center gap-2 text-sm text-emerald-600 hover:text-emerald-700 break-all"
                                    >
                                      <Download size={14} />
                                      {doc.name || doc.originalName || `Document ${docIndex + 1}`}
                                    </a>
                                  ))}
                                </div>
                              </div>
                            )}
                            {project.photos && project.photos.length > 0 && (
                              <div>
                                <p className="text-xs font-medium text-gray-500 uppercase mb-2">Photos</p>
                                <div className="grid grid-cols-2 gap-2">
                                  {project.photos.map((photo, photoIndex) => (
                                    <img
                                      key={photoIndex}
                                      src={photo.url || photo}
                                      alt={`Project photo ${photoIndex + 1}`}
                                      className="w-full h-32 object-cover rounded-lg border border-gray-100"
                                    />
                                  ))}
                                </div>
                              </div>
                            )}
                          </div>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div className="text-center py-12 bg-white rounded-lg">
                  <p className="text-gray-500">No projects to display</p>
                </div>
              )}
            </div>

            {/* Divider */}
            <hr className="my-12" />

            {/* Products & Services Section */}
            <div className="mb-12">
              <h2 className="text-3xl font-bold text-gray-900 mb-2">Products & Services</h2>
              <p className="text-gray-600 mb-8">Portfolio of offerings</p>
              
              {/* Products */}
              {products && products.length > 0 && (
                <div className="mb-12">
                  <h3 className="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                    <span className="w-1 h-8 bg-purple-600 rounded-full"></span>
                    Products
                  </h3>
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {products.map((product, index) => (
                      <div key={product.id || product.productId || index} className="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow p-6">
                        <h4 className="font-bold text-lg text-gray-900 mb-2">{product.name || product.productName || 'Untitled Product'}</h4>
                        <p className="text-sm text-gray-600 mb-4">{product.category || 'Uncategorized'}</p>
                        
                        {product.description && (
                          <p className="text-sm text-gray-700">{product.description}</p>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {/* Services */}
              {services && services.length > 0 && (
                <div className="mb-12">
                  <h3 className="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                    <span className="w-1 h-8 bg-blue-600 rounded-full"></span>
                    Services
                  </h3>
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {services.map((service, index) => (
                      <div key={service.id || index} className="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow p-6">
                        <h4 className="font-bold text-lg text-gray-900 mb-2">{service.name || 'Untitled Service'}</h4>
                        <p className="text-sm text-gray-600 mb-4">{service.category || 'Uncategorized'}</p>
                        
                        {service.description && (
                          <p className="text-sm text-gray-700">{service.description}</p>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {/* No products or services message */}
              {(!products || products.length === 0) && (!services || services.length === 0) && (
                <div className="text-center py-12 bg-white rounded-lg">
                  <p className="text-gray-500">No products or services to display</p>
                </div>
              )}
            </div>
          </div>
        </>
      )}
    </div>
  );
}
